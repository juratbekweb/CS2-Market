# ==========================================
# CS2 Market - Environment Variables Example
# ==========================================

# 1. NextAuth / Auth Settings
# Preferred standard for NextAuth v5
AUTH_SECRET="replace-with-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# 2. Database Connection (required for production)
# Use your Neon PostgreSQL URL here.
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# 3. Steam API
# Required if syncing live data from Steam
STEAM_API_KEY="your-steam-api-key"

# 4. Socket Server
NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"

# 5. Optional legacy alias
# NEXTAUTH_SECRET="replace-with-32-byte-secret"
