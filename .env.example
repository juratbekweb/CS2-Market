# ==========================================
# CS2 Market - Environment Variables Example
# ==========================================

# 1. NextAuth Settings
# Generate a secret via: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# 2. Database Connection
# Used for live Prisma connection (e.g., Neon PostgreSQL)
# If omitted, the application runs in mock fallback mode locally.
# DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# 3. Steam API
# Required if syncing live data from Steam
# STEAM_API_KEY="your-steam-api-key"

# 4. Socket Server
# Points to the real-time activity WebSocket server
NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"
