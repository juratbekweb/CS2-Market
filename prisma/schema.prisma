generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PURCHASE
  SALE
  COMMISSION
  UPGRADE_WIN
  UPGRADE_LOSS
  CASE_OPEN
  CASE_WIN
  REFERRAL_BONUS
  PROMO_REDEEM
  DAILY_BONUS
}

enum TradeStatus {
  PENDING
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum TradeDirection {
  DEPOSIT
  WITHDRAWAL
}

enum UpgradeResult {
  WIN
  LOSE
}

enum CaseBattleStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum DepositStatus {
  PENDING
  COMPLETED
  FAILED
}

// ─── CORE MODELS ──────────────────────────────────────

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String?           @unique
  emailVerified    DateTime?
  image            String?
  avatar           String?
  steamId          String?           @unique
  tradeUrl         String?
  role             Role              @default(USER)
  isBlocked        Boolean           @default(false)
  referralCode     String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  accounts         Account[]
  sessions         Session[]
  listings         Listing[]
  favorites        Favorite[]
  inventoryItems   InventoryItem[]
  transactions     Transaction[]
  notifications    Notification[]
  balance          Decimal           @default(0) @db.Decimal(12, 2)
  totalProfit      Decimal           @default(0) @db.Decimal(12, 2)
  trades           Trade[]
  upgrades         Upgrade[]
  caseOpenings     CaseOpening[]
  referralsMade    Referral[]        @relation("ReferralsMade")
  referralReceived Referral?         @relation("ReferralReceived")
  promoRedemptions PromoRedemption[]
  dailyBonuses     DailyBonus[]

  // Advanced Features
  wallet      Wallet?
  withdrawals WithdrawalRequest[]
  deposits    Deposit[]
  currentSeed UserSeed?
  seedHistory SeedHistory[]
}

model Skin {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  category       String
  rarity         String
  exterior       String
  wear           Float
  price          Decimal         @db.Decimal(12, 2)
  image          String
  finishStyle    String
  description    String
  collection     String
  liquidityScore Int
  steamMarketId  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  listings       Listing[]
  favorites      Favorite[]
  inventoryItems InventoryItem[]
  pricePoints    PricePoint[]
  caseItems      CaseItem[]
  caseWins       CaseOpening[]
}

model Listing {
  id        String        @id @default(cuid())
  sellerId  String
  skinId    String
  askPrice  Decimal       @db.Decimal(12, 2)
  status    ListingStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  soldAt    DateTime?
  seller    User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  skin      Skin          @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([sellerId])
  @@index([skinId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  skinId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skin      Skin     @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@unique([userId, skinId])
}

model InventoryItem {
  id           String   @id @default(cuid())
  userId       String
  skinId       String
  acquisition  Decimal  @db.Decimal(12, 2)
  currentValue Decimal  @db.Decimal(12, 2)
  isListed     Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skin         Skin     @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([skinId])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  description String
  metadata    Json?
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PricePoint {
  id     String   @id @default(cuid())
  skinId String
  date   DateTime
  value  Decimal  @db.Decimal(12, 2)
  skin   Skin     @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@index([skinId])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── TRADE SYSTEM ─────────────────────────────────────

model Trade {
  id           String         @id @default(cuid())
  userId       String
  steamTradeId String?        @unique
  direction    TradeDirection
  status       TradeStatus    @default(PENDING)
  items        Json
  totalValue   Decimal        @db.Decimal(12, 2)
  tradeUrl     String?
  errorMessage String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── UPGRADE SYSTEM ───────────────────────────────────

model Upgrade {
  id           String        @id @default(cuid())
  userId       String
  inputItemId  String
  inputValue   Decimal       @db.Decimal(12, 2)
  targetItemId String
  targetValue  Decimal       @db.Decimal(12, 2)
  chance       Float
  houseEdge    Float
  rollValue    Float
  result       UpgradeResult
  serverSeed   String
  clientSeed   String
  nonce        Int
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── CASE SYSTEM ──────────────────────────────────────

model Case {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  price     Decimal       @db.Decimal(12, 2)
  image     String
  isActive  Boolean       @default(true)
  items     CaseItem[]
  openings  CaseOpening[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model CaseItem {
  id       String @id @default(cuid())
  caseId   String
  skinId   String
  rarity   String
  dropRate Float
  case     Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  skin     Skin   @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([skinId])
}

model CaseOpening {
  id         String   @id @default(cuid())
  userId     String
  caseId     String
  wonSkinId  String
  wonValue   Decimal  @db.Decimal(12, 2)
  serverSeed String
  clientSeed String
  nonce      Int
  rollValue  Float
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  wonSkin    Skin     @relation(fields: [wonSkinId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([caseId])
}

// ─── CASE BATTLE SYSTEM ───────────────────────────────

model CaseBattle {
  id         String           @id @default(cuid())
  status     CaseBattleStatus @default(PENDING)
  cases      Json // Array of case IDs
  players    Json // Array of player objects with seat, userId, skins won, total value
  winnerId   String?
  totalValue Decimal          @default(0) @db.Decimal(12, 2)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status])
  @@index([winnerId])
}

// ─── RETENTION MODELS ─────────────────────────────────

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referredId String   @unique
  commission Decimal  @default(0) @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  referrer   User     @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referred   User     @relation("ReferralReceived", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

model PromoCode {
  id          String            @id @default(cuid())
  code        String            @unique
  amount      Decimal           @db.Decimal(12, 2)
  maxUses     Int
  usedCount   Int               @default(0)
  expiresAt   DateTime?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  redemptions PromoRedemption[]
}

model PromoRedemption {
  id          String    @id @default(cuid())
  userId      String
  promoCodeId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([userId, promoCodeId])
}

model DailyBonus {
  id        String   @id @default(cuid())
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  day       Int
  claimedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── AUTH MODELS ──────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── ADVANCED FEATURES MODELS ─────────────────────────

// NOTE: Wallet is currently redundant as balance is tracked directly on the User model.
// Kept for backward compatibility to prevent breaking changes.

model Wallet {
  id            String   @id @default(cuid())
  userId        String   @unique
  balance       Decimal  @default(0) @db.Decimal(12, 2)
  lockedBalance Decimal  @default(0) @db.Decimal(12, 2) // For pending withdrawals
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WithdrawalRequest {
  id           String           @id @default(cuid())
  userId       String
  amount       Decimal          @db.Decimal(12, 2)
  status       WithdrawalStatus @default(PENDING)
  tradeUrl     String
  steamTradeId String?
  errorMessage String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Deposit {
  id           String        @id @default(cuid())
  userId       String
  amount       Decimal       @db.Decimal(12, 2)
  status       DepositStatus @default(PENDING)
  provider     String // e.g., "crypto", "card"
  providerTxId String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BotLog {
  id        String   @id @default(cuid())
  action    String // e.g., "PROCESS_WITHDRAWAL", "DISTRIBUTE_REWARD"
  status    String // e.g., "SUCCESS", "FAILED"
  details   Json? // Contextual data
  createdAt DateTime @default(now())
}

model UserSeed {
  id                String   @id @default(cuid())
  userId            String   @unique
  hashedServerSeed  String
  currentClientSeed String
  nonce             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SeedHistory {
  id               String   @id @default(cuid())
  userId           String
  serverSeed       String // The actual revealed seed
  hashedServerSeed String
  clientSeed       String
  finalNonce       Int
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
